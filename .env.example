# ShopSmart Sales Analytics Dashboard — Environment Configuration
# Copy this file to .env and fill in values as needed.
# For Phase 1 (CSV-based), no variables are required.

# Path to the sales data CSV file (relative to repo root).
# Defaults to data/sales-data.csv if not set.
# DASHBOARD_DATA_PATH=data/sales-data.csv

# Streamlit server configuration (optional).
# These can also be set via .streamlit/config.toml.
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Future Phase 2: API connection settings (not used in Phase 1)
# SALES_API_BASE_URL=
# SALES_API_KEY=
